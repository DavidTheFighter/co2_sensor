	(text "CELL_DTR has an internal pullup, and when pulled high\nputs the modem into a lower power state (a few microamps allegedly\nonce the cellular modem also goes into power saving mode on its own).\n\nCELL_RI notifies the external MCU that there's incoming data ready.\n\nhttps://nrfconnectdocs.nordicsemi.com/addons/addon-serial_modem/latest/main/uart_configuration.html"
		(exclude_from_sim no)
		(at 230.632 155.702 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "430d5034-7407-41e5-b31e-f17029ada061")
	)
